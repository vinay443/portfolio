# Copy to .env.local for local development, and set the same variable in the
# Vercel project settings for deploys. Never commit a real .env file.

# Absolute origin of the deployed site, no trailing slash. Feeds metadataBase, the
# sitemap, robots.txt and the JSON-LD url. Inlined at build time, so it must be set
# before `next build`.
#
# Unset, `next dev` falls back to http://localhost:3000, but a production build
# (`next build`, and every Vercel deployment, previews included) fails with an error.
# In Vercel, enable it for both Production and Preview.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
